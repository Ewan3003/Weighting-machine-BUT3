#include <Arduino.h>        // Includes the core Arduino functions and definitions
#include <HX711.h>          // Library for the HX711 24-bit ADC module (used with load cells)
#include <WiFi.h>           // Library to connect the ESP32 to WiFi networks
#include <esp_wpa2.h>       // Enables WPA2 Enterprise authentication (needed for eduroam)
#include <PubSubClient.h>   // Library to manage MQTT communication (publish/subscribe)


// ---------- Global variables ----------
float masse;                // Variable to store the measured mass
float reading;              // Raw reading from the HX711 after scaling
float incertitude;          // Computed uncertainty for each measurement
float incertitude_verif;    // Verified uncertainty (discrete range values)


// ---------- HX711 configuration ----------
const int LOADCELL_DOUT_PIN = 19;     // Pin on ESP32 connected to HX711 data output (DOUT)
const int LOADCELL_SCK_PIN = 21;      // Pin on ESP32 connected to HX711 clock (SCK)
const int Calibration_Weight = 50;    // Known calibration weight in grams
HX711 scale;                          // Create an HX711 object called “scale”


// ---------- WiFi configuration ----------
const char* ssid = "eduroam";         // SSID of the WiFi network (eduroam)

#define CONNECTION_TIMEOUT 10          // Maximum connection timeout (not used here)
int timeout_counter = 0;               // Counter to keep track of connection attempts


// ---------- MQTT Broker configuration ----------
const char *mqtt_broker = "172.23.238.55";  // IP address of the MQTT broker (server)
const char *topic1 = "IUT/balance";         // MQTT topic for publishing mass data
const char *topic2 = "IUT/balance/verif";   // MQTT topic for publishing verified uncertainty
const char *mqtt_username = "";             // MQTT username (empty if not required)
const char *mqtt_password = "";             // MQTT password (empty if not required)
const int mqtt_port = 1883;                 // Port for MQTT (1883 = standard non-secure)
WiFiClient espClient;                       // Create WiFi client to handle connection
PubSubClient client(espClient);             // Create MQTT client using the WiFi client


// ---------- WPA2 Enterprise credentials (for eduroam) ----------
#define EAP_IDENTITY "prenom.nom@etu.univ-amu.fr"  // Identity used for WPA2 Enterprise
#define EAP_PASSWORD "mdp"                         // Password for eduroam login
#define EAP_USERNAME "prenom.nom@etu.univ-amu.fr"  // Username (same as identity)


// ---------- MQTT callback function ----------
// This function runs automatically whenever a message is received on a subscribed topic.
void callback(char *topic, byte *payload, unsigned int length) { 
  Serial.print("Message received on topic: ");   // Print the topic of the incoming message
  Serial.println(topic);                         // Display the topic name
  Serial.print("Message: ");                     // Print the word “Message: ”
  for (int i = 0; i < length; i++) {             // Loop through each byte of the payload
    Serial.print((char) payload[i]);             // Convert byte to character and print it
  } 
  Serial.println();                              // Move to a new line after printing message
  Serial.println("-----------------------");   // Separator for readability
}


// ---------- Setup function ----------
// Runs once at startup to initialize components and establish connections
void setup() {
  Serial.begin(115200);                               // Start serial communication at 115200 baud rate

  scale.begin(LOADCELL_DOUT_PIN, LOADCELL_SCK_PIN);   // Initialize HX711 using defined pins
  scale.set_scale();                                  // Reset scale factor (initially 1)
  scale.tare();                                       // Reset the scale to zero (remove any offset)

  Serial.println("-----------------------------------------");
  Serial.println("Calibration");                      // Notify user that calibration is starting
  Serial.println("Put a known weight on the scale");  // Instruction to place a calibration weight

  // ---------- Connect to WiFi (eduroam, WPA2 Enterprise) ----------
  WiFi.disconnect(true);                              // Disconnect from any previous WiFi connection
  WiFi.begin(ssid, WPA2_AUTH_PEAP, EAP_IDENTITY, EAP_USERNAME, EAP_PASSWORD); // Start WPA2 Enterprise connection
  while (WiFi.status() != WL_CONNECTED) {             // Wait until connection is established
    delay(500);                                       // Wait half a second between checks
    Serial.print(F("."));                             // Print a dot each time for visual feedback
  }
  Serial.println("");                                 // Move to a new line once connected
  Serial.println(F("ESP32 connected to WiFi!"));      // Confirm WiFi connection success

  // ---------- MQTT Broker connection ----------
  client.setServer(mqtt_broker, mqtt_port);           // Define broker address and port
  client.setCallback(callback);                       // Link callback function to handle incoming messages

  while (!client.connected()) {                       // Try connecting until success
    String client_id = "esp32-client-";               // Create a unique MQTT client ID
    client_id += String(WiFi.macAddress());           // Append MAC address for uniqueness
    Serial.printf("Measurement chain %s connecting to MQTT broker", client_id.c_str()); 
 
    if (client.connect(client_id.c_str(), mqtt_username, mqtt_password)) { 
      Serial.println("Measurement chain connected to MQTT broker.");  // Success message
    } else { 
      Serial.print("Failed to connect to MQTT broker... "); 
      Serial.print(client.state());                  // Print connection state (error code)
    } 
  } 

  delay(5000);                                       // Wait 5 seconds before calibration

  // ---------- Scale calibration ----------
  float x = scale.get_units(10);                     // Take the average of 10 readings
  x = x / Calibration_Weight;                        // Divide measured value by known mass
  scale.set_scale(x);                                // Apply calibration factor to scale
  Serial.println("Calibration finished...");          // Notify that calibration is complete
  delay(1000);                                       // Wait 1 second before starting the loop
}


// ---------- Loop function ----------
// Runs continuously after setup() completes
void loop() {

  // ---------- Read mass from HX711 ----------
  if (scale.is_ready()) {                            // Check if the HX711 is ready to send data
    reading = scale.get_units(10);                   // Take 10 averaged readings
    Serial.print("HX711 reading: ");                 // Label for the reading
    Serial.println(reading);                         // Print the measured value
  }

  masse = reading;                                   // Store the current reading as the mass
  incertitude = 0.0002 * reading + 0.0292;           // Compute uncertainty using a linear equation

  // ---------- Send mass data to MQTT ----------
  String message = String(masse, 2) + " ± " + String(incertitude, 2);  // Create message with uncertainty
  client.publish(topic1, String(masse).c_str());     // Publish mass value as a string to topic1
  Serial.println("Message sent: " + message);        // Print confirmation to serial monitor

  // ---------- Determine verified uncertainty (stepwise approximation) ----------
  if (masse <= 5) {
    incertitude_verif = 0.081;                       // Verified uncertainty for small masses
  } else if (masse <= 10) {
    incertitude_verif = 0.13;                        // Verified uncertainty for 5–10 g
  } else if (masse <= 50) {
    incertitude_verif = 0.16;                        // Verified uncertainty for 10–50 g
  } else if (masse <= 100) {
    incertitude_verif = 0.26;                        // Verified uncertainty for 50–100 g
  } else {
    incertitude_verif = 0.53;                        // Default uncertainty for masses >100 g
  }

  // ---------- Send verified data to MQTT ----------
  String message_verif = String(masse, 2) + " ± " + String(incertitude_verif, 2);  // Create formatted string
  client.publish(topic2, message_verif.c_str());       // Publish to the verification topic
  Serial.println("With verified masses: " + message_verif); // Print confirmation

  // ---------- Maintain MQTT connection ----------
  // Subscribe to a topic to receive messages (⚠️ 'topic' variable is not defined anywhere)
  client.subscribe(topic);                             // This line will cause a compilation error
  client.loop();                                       // Keeps MQTT connection alive and processes messages

  delay(5000);                                         // Wait 5 seconds before the next measurement cycle
}
